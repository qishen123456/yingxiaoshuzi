{
  "name": "yanxuan-marketing-backend",
  "version": "0.1.0",
  "description": "研选营销智能推送系统 - 后端（NestJS 11 + Prisma + PostgreSQL 16）",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env -r @swc-node/register src/main.ts",
    "start:prod": "node dist/main.js",
    "dev": "node --env-file=.env --watch -r @swc-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed:sql": "node --env-file=.env -r @swc-node/register scripts/run-sql-seeds.ts",
    "demo:data": "node --env-file=.env -r @swc-node/register scripts/load-demo-data.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/schedule": "^6.0.0",
    "@prisma/client": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "prisma": "^6.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
