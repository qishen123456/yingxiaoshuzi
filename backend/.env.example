# PostgreSQL 连接串（docker-compose 默认服务名 db）
# options 固定会话时区为 Asia/Shanghai，保证 date 列（stat_date）不发生 UTC 跨日偏移
DATABASE_URL="postgresql://marketing:marketing_dev_pwd@localhost:5434/yanxuan_marketing?schema=public&options=-c%20timezone%3DAsia/Shanghai"

# 服务端口
PORT=3000

# 客户键 HMAC 密钥（ADR-013：必须与 push_detail.customer_key_hash / lead_record.customer_key 同源）
# 生产环境由配置中心下发；本地开发仅用此默认值，禁止用于真实数据
CUSTOMER_KEY_SECRET="dev-only-customer-key-secret-change-me"

# 号码对称加密密钥（必须是 32 字节随机值的 base64，AES-256-GCM 随机 IV；本地开发默认值）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOBILE_ENC_KEY_BASE64="CwbbT01J/eCkGqM35Yr/xvPR0l1A6/wI72waRD6wJEQ="

# 跑批 dry-run：true=不调用任何真实通道，发送步骤只把 queued 模拟为 sent（骨架默认）
DRY_RUN="true"
